DEEPL_API_KEY=""
BYPASS_AUTH_IN_DEV=false
LOG_LEVEL=debug
LOG_FORMAT=pretty
SLOW_REQUEST_MS=1000
# Optional Core API base URL (defaults to https://core.api.neuland.app)
# CORE_API_BASE_URL=https://core.api.neuland.app
# OpenTelemetry traces (optional). When unset, tracing is disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20token
# OTEL_SERVICE_NAME=neuland.app-backend
